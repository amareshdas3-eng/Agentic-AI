# Option 1: Official Meta Graph API (100% Autonomous Background Posting)
# To get these:
# 1. Connect your Instagram Professional account to a Facebook Page.
# 2. Create an App in developers.facebook.com with 'instagram_content_publish' permission.
# 3. Generate a Long-Lived User Access Token.
INSTAGRAM_ACCESS_TOKEN=your_meta_graph_api_long_lived_token_here
INSTAGRAM_USER_ID=your_instagram_business_account_id_here

# Option 2: Webhook / Automation Platform
# (e.g. Make.com, Buffer, Zapier, or Ayrshare webhook)
INSTAGRAM_WEBHOOK_URL=https://your-webhook-endpoint.com/publish

